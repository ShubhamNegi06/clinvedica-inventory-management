# --- App ---
APP_ENV=development
DEBUG=true

# --- Database (Supabase Postgres connection string, session pooler recommended) ---
DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@[HOST]:5432/postgres

# --- Supabase Auth ---
SUPABASE_URL=https://zatytfclhrmupuaywxbb.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NEVER expose to frontend — server only

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=clinvedica-reports

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,https://your-production-domain.com

# --- Frontend base URL (used for Supabase invite/password-reset redirect links) ---
# IMPORTANT: FRONTEND_URL + "/set-password" must also be added to
# Supabase Dashboard -> Authentication -> URL Configuration -> Redirect URLs,
# or Supabase will silently ignore redirect_to and the invite link won't work.
FRONTEND_URL=http://localhost:3000
