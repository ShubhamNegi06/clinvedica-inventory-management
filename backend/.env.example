# --- App ---
APP_ENV=development
DEBUG=true

# --- Database (Supabase Postgres connection string, session pooler recommended) ---
# Supabase is used purely as a Postgres host now — Supabase Auth is no
# longer part of this app anywhere.
DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@[HOST]:5432/postgres

# --- JWT auth (custom, replaces Supabase Auth) ---
# Generate a strong secret with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_COOKIE_NAME=refresh_token
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
INVITE_TOKEN_EXPIRE_HOURS=72
# Keep false unless you actually want public self-service sign-up — this
# platform is internal/admin-provisioned by design.
ALLOW_PUBLIC_REGISTRATION=false

# --- SMTP (replaces Supabase's built-in email delivery) ---
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@clinvedica.com
SMTP_FROM_NAME=Clinvedica Specimen Inventory
SMTP_USE_TLS=true

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=clinvedica-reports

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
# Optional: point broker/backend at separate Redis instances/DBs.
# Both default to REDIS_URL if left blank.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:3000,https://your-production-domain.com

# --- Frontend base URL (used for invite/password-reset email links) ---
FRONTEND_URL=http://localhost:3000
